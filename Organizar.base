filters:
  and:
    - file.folder != "_templates"
properties:
  file.name:
    displayName: Nome da Nota
  note.area:
    displayName: areas
views:
  - type: table
    name: Temas
    filters:
      or:
        - Tipo == "tema"
        - Tipo == "estudo"
    order:
      - file.name
      - Tipo
      - status
      - publish
      - areas
    sort:
      - property: importancia
        direction: DESC
      - property: subarea
        direction: ASC
    columnSize:
      note.Tipo: 71
      note.status: 103
  - type: table
    name: Inbox
    filters:
      and:
        - file.folder == "00_Inbox"
        - areas.containsAny("Obstetrícia,Ginecologia")
    order:
      - file.name
      - areas
  - type: table
    name: Estudo
    filters:
      and:
        - file.inFolder("01_Estudo")
        - areas.containsAny("Ginecologia", "Obstetrícia")
    order:
      - file.name
      - areas
