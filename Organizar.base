filters:
  and:
    - file.folder != "_templates"
properties:
  file.name:
    displayName: Nome da Nota
  note.area:
    displayName: areas
  note.publish:
    displayName: publish
  note.Tipo:
    displayName: tipo
views:
  - type: table
    name: Temas
    filters:
      or:
        - Tipo == "tema"
        - Tipo == "estudo"
    order:
      - file.name
      - Tipo
      - status
      - publish
      - areas
    sort:
      - property: importancia
        direction: DESC
      - property: subarea
        direction: ASC
    columnSize:
      note.Tipo: 71
      note.status: 103
  - type: table
    name: Inbox
    filters:
      and:
        - file.folder == "00_Inbox"
    order:
      - file.name
      - areas
      - Tipo
    sort:
      - property: date
        direction: ASC
    columnOrders:
      file.file:
        - 00_Inbox/Aleitamento Materno - MEDCURSO.md
        - 00_Inbox/Alto Risco - UFRN.md
